[Unit]
Description=Fixora Dramatiq Worker
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=fixora
Group=fixora
SupplementaryGroups=fixora-runner
WorkingDirectory=/srv/fixora/backend
EnvironmentFile=/etc/fixora/fixora.env
ExecStart=/srv/fixora/backend/.venv/bin/dramatiq fixora.worker --processes 1 --threads 2
Restart=on-failure
PrivateTmp=no
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/fixora /tmp/fixora

[Install]
WantedBy=multi-user.target

