FIXORA_DATABASE_URL=postgresql+psycopg://fixora:fixora@127.0.0.1:5433/fixora
FIXORA_REDIS_URL=redis://127.0.0.1:6380/0
# 不设置时：macOS ~/Library/Application Support/Fixora；Linux ~/.local/share/fixora
# 生产：FIXORA_DATA_ROOT=/var/lib/fixora
# FIXORA_DATA_ROOT=
FIXORA_WEB_ORIGIN=http://127.0.0.1:5173
FIXORA_SYSTEMD_RUNNER_ENABLED=false
FIXORA_SYSTEMD_RUNNER_USER=fixora-runner

# GitLab 只从环境变量读取；网页设置页不会修改这些值。
FIXORA_GITLAB_BASE_URL=https://gitlab.example.com
FIXORA_GITLAB_TOKEN=
# 与 MemLoci 一致：内网自签 GitLab 默认关闭证书校验。
FIXORA_GITLAB_SSL_VERIFY=false
# 内网自签 CA 可填写服务器上的证书路径。
FIXORA_GITLAB_CA_BUNDLE=

# 模型只从环境变量读取；网页设置页不会修改这些值。
# 填写第三方 OpenAI-compatible 网关；不会自动回落到 OpenAI。
# 可填网关根地址、/v1，或完整 /chat/completions、/responses；程序会统一拼接 endpoint。
FIXORA_MODEL_API_URL=https://your-openai-compatible-gateway.example.com/v1
FIXORA_MODEL_API_KEY=
# responses 或 chat_completions；改后重启 API 和 Worker。
FIXORA_MODEL_API_MODE=responses
FIXORA_MODEL_NAME=
FIXORA_MODEL_REASONING_EFFORT=medium
FIXORA_MODEL_PARAMETERS_JSON={}
# 与 MemLoci 一致：第三方自签模型网关默认关闭证书校验。
FIXORA_MODEL_SSL_VERIFY=false
# 禁止 OpenAI Agents SDK 把调用轨迹导出到 OpenAI。
FIXORA_MODEL_TRACING_ENABLED=false
